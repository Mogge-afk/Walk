<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hundpromenaden</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{background:#0d1a0b;display:flex;justify-content:center;align-items:flex-start;min-height:100vh;padding:20px;font-family:system-ui,sans-serif;}
#gw{width:380px;border-radius:12px;overflow:hidden;user-select:none;box-shadow:0 8px 32px rgba(0,0,0,0.6);}
#sc{position:relative;height:240px;overflow:hidden;}
#cv{display:block;}
#dogs-wrap{position:absolute;bottom:0;left:50%;transform:translateX(-50%);pointer-events:none;}
#enemy{position:absolute;font-size:40px;top:50px;left:50%;transform:translateX(-50%) scale(0.2);display:none;transition:top 1s ease,transform 1s ease;filter:drop-shadow(0 2px 6px rgba(0,0,0,0.6));}
#enemy.near{top:95px;transform:translateX(-50%) scale(1);}
#flash{position:absolute;top:36%;left:50%;transform:translate(-50%,-50%);font-size:20px;font-weight:600;color:#fff;text-shadow:0 2px 10px #000;display:none;white-space:nowrap;pointer-events:none;}
#lv-b{position:absolute;top:8px;left:10px;background:rgba(0,0,0,0.55);color:#c8ddb0;font-size:11px;padding:3px 9px;border-radius:20px;}
#sc-b{position:absolute;top:8px;right:10px;background:rgba(0,0,0,0.55);color:#c8ddb0;font-size:11px;padding:3px 9px;border-radius:20px;}
#biome-label{position:absolute;bottom:6px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.6);color:#d4efc4;font-size:11px;padding:2px 12px;border-radius:12px;display:none;white-space:nowrap;}
#ui{padding:11px 13px;background:#111e0f;}
#st{font-size:13px;color:#b8d8a0;text-align:center;margin-bottom:9px;min-height:17px;}
#hp{display:flex;justify-content:center;gap:5px;margin-bottom:9px;}
#btns{display:flex;gap:7px;flex-wrap:wrap;}
.gb{flex:1;min-width:72px;padding:9px 5px;background:rgba(255,255,255,0.09);border:0.5px solid rgba(255,255,255,0.20);border-radius:8px;color:#dff0d0;font-size:12px;cursor:pointer;text-align:center;transition:background .12s,transform .1s;}
.gb:hover{background:rgba(255,255,255,0.18);}
.gb:active{transform:scale(0.96);}
.gb.at{background:rgba(200,55,35,0.28);border-color:rgba(220,75,55,0.5);}
.gb.at:hover{background:rgba(200,55,35,0.44);}
.gb.pt{background:rgba(50,120,50,0.28);border-color:rgba(70,170,70,0.44);}
.gb.pt:hover{background:rgba(50,120,50,0.44);}
</style>
</head>
<body>
<div id="gw">
  <div id="sc">
    <canvas id="cv" width="380" height="240"></canvas>
    <div id="dogs-wrap">
      <svg width="150" height="115" viewBox="0 0 150 115">
        <line x1="8" y1="115" x2="44" y2="58" stroke="#8a7060" stroke-width="2" opacity="0.8"/>
        <line x1="142" y1="115" x2="106" y2="58" stroke="#8a7060" stroke-width="2" opacity="0.8"/>
        <g id="dL">
          <ellipse cx="44" cy="78" rx="23" ry="15" fill="#3a3a3a"/>
          <ellipse cx="33" cy="82" rx="9" ry="11" fill="#2a2a2a"/>
          <ellipse cx="55" cy="82" rx="9" ry="11" fill="#2a2a2a"/>
          <ellipse cx="44" cy="87" rx="11" ry="8" fill="#484848"/>
          <rect x="27" y="87" width="7" height="17" rx="3" fill="#2a2a2a"/>
          <rect x="37" y="88" width="7" height="16" rx="3" fill="#333"/>
          <rect x="47" y="88" width="7" height="16" rx="3" fill="#2a2a2a"/>
          <rect x="57" y="87" width="7" height="17" rx="3" fill="#333"/>
          <path id="tL" d="M21 73 Q8 62 12 51" stroke="#484848" stroke-width="7" fill="none" stroke-linecap="round"/>
          <ellipse cx="44" cy="60" rx="17" ry="15" fill="#2d2d2d"/>
          <ellipse cx="29" cy="56" rx="7" ry="13" fill="#1a1a1a" transform="rotate(-13 29 56)"/>
          <ellipse cx="59" cy="56" rx="7" ry="13" fill="#1a1a1a" transform="rotate(13 59 56)"/>
          <ellipse cx="42" cy="62" rx="9" ry="8" fill="#888" opacity="0.35"/>
          <rect x="32" y="68" width="24" height="4" rx="2" fill="#c03030"/>
        </g>
        <g id="dR">
          <ellipse cx="106" cy="78" rx="23" ry="15" fill="#6b3d1e"/>
          <ellipse cx="95" cy="82" rx="9" ry="11" fill="#5a3018"/>
          <ellipse cx="117" cy="82" rx="9" ry="11" fill="#5a3018"/>
          <ellipse cx="106" cy="87" rx="11" ry="8" fill="#7a4828"/>
          <rect x="89" y="87" width="7" height="17" rx="3" fill="#5a3018"/>
          <rect x="99" y="88" width="7" height="16" rx="3" fill="#6b3d1e"/>
          <rect x="109" y="88" width="7" height="16" rx="3" fill="#5a3018"/>
          <rect x="119" y="87" width="7" height="17" rx="3" fill="#6b3d1e"/>
          <path id="tR" d="M129 73 Q142 62 138 51" stroke="#7a4828" stroke-width="7" fill="none" stroke-linecap="round"/>
          <path d="M136 55 Q142 50 139 45" stroke="#d4c8a8" stroke-width="5" fill="none" stroke-linecap="round"/>
          <ellipse cx="106" cy="60" rx="17" ry="15" fill="#6b3d1e"/>
          <ellipse cx="91" cy="56" rx="7" ry="13" fill="#5a3018" transform="rotate(-13 91 56)"/>
          <ellipse cx="121" cy="56" rx="7" ry="13" fill="#5a3018" transform="rotate(13 121 56)"/>
          <ellipse cx="104" cy="62" rx="9" ry="8" fill="#c8a46e" opacity="0.3"/>
          <rect x="94" y="68" width="24" height="4" rx="2" fill="#2060a0"/>
        </g>
      </svg>
    </div>
    <div id="enemy"></div>
    <div id="flash"></div>
    <div id="lv-b">Nivå <span id="lv">1</span></div>
    <div id="sc-b">⭐ <span id="score">0</span></div>
    <div id="biome-label"></div>
  </div>
  <div id="ui">
    <div id="hp">
      <span id="h0">🐾</span><span id="h1">🐾</span><span id="h2">🐾</span>
    </div>
    <div id="st">Redo att ge sig ut?</div>
    <div id="btns"></div>
  </div>
</div>

<script>
window.onload = function() {

  // ============================================================
  // ELEMENTS
  // ============================================================
  const cv  = document.getElementById('cv');
  const ctx = cv.getContext('2d');
  const W = 380, H = 240, HORIZON = 100;
  cv.width = W; cv.height = H;

  const elDogs  = document.getElementById('dogs-wrap');
  const elEnemy = document.getElementById('enemy');
  const elFlash = document.getElementById('flash');
  const elLv    = document.getElementById('lv');
  const elScore = document.getElementById('score');
  const elBiome = document.getElementById('biome-label');
  const elSt    = document.getElementById('st');
  const elBtns  = document.getElementById('btns');
  const elHp    = [0,1,2].map(i => document.getElementById('h'+i));
  const elTL    = document.getElementById('tL');
  const elTR    = document.getElementById('tR');

  // ============================================================
  // GAME DATA
  // ============================================================
  const CROSSINGS = [
    {name:'Trevägskorsning', icon:'🌲', dirs:[{l:'⬅ Vänster',v:-1},{l:'⬆ Rakt',v:0},{l:'➡ Höger',v:1}]},
    {name:'T-korsning',      icon:'🌲', dirs:[{l:'⬅ Vänster',v:-1},{l:'➡ Höger',v:1}]},
    {name:'Gaffelkorsning',  icon:'🌲', dirs:[{l:'↖ Skogen',v:-1},{l:'↗ Öppet fält',v:1}]},
    {name:'Kurva',           icon:'🌿', dirs:[{l:'⬅ Sväng vänster',v:-1},{l:'➡ Sväng höger',v:1}]},
  ];

  const ENEMIES = [
    {icon:'🦊', name:'räv',      lv:1, good:['skälla','bita'],  hint:'Rävar skyr högt ljud!'},
    {icon:'🐦', name:'korp',     lv:1, good:['hoppa','skälla'], hint:'Fåglar hatar stora rörelser!'},
    {icon:'🦔', name:'igelkott', lv:2, good:['hoppa'],          hint:'Taggar gör ont att bita!'},
    {icon:'🦌', name:'rådjur',   lv:2, good:['skälla','bita'],  hint:'Rådjur skräms av ljud!'},
    {icon:'🐺', name:'varg',     lv:3, good:['bita'],           hint:'Möt vargen med styrka!'},
    {icon:'🐗', name:'vildsvin', lv:3, good:['hoppa','skälla'], hint:'Spring inte rakt mot galten!'},
  ];

  // ============================================================
  // MODE-7 FOREST PATH RENDERER
  // ============================================================
  let targetCurve  = 0;
  let currentCurve = 0;
  let camAngle     = 0;
  let scroll       = 0;
  let walking      = false;   // only scroll/animate while actually walking
  let returnTimer  = null;

  const ROWS = H - HORIZON;
  const depthLUT = new Float32Array(ROWS);
  for (let sy = 0; sy < ROWS; sy++) depthLUT[sy] = 200 / (sy + 1);

  function setCurve(v, autoReturn) {
    targetCurve = v;
    if (autoReturn && v !== 0) {
      clearTimeout(returnTimer);
      returnTimer = setTimeout(() => { targetCurve = 0; }, 1700);
    }
  }

  function drawSky() {
    const sg = ctx.createLinearGradient(0,0,0,HORIZON);
    sg.addColorStop(0,'#8fb0d8');
    sg.addColorStop(1,'#bcd9a8');
    ctx.fillStyle = sg;
    ctx.fillRect(0,0,W,HORIZON);

    // Distant treeline silhouette, scrolls with camera pan
    ctx.fillStyle = '#183a10';
    ctx.fillRect(0, HORIZON-22, W, 26);
    const off = ((camAngle * 80) % 26 + 26) % 26;
    for (let x = -26; x < W+26; x += 26) {
      const xx = x + off;
      const hh = 12 + Math.sin(xx*0.18)*5 + Math.cos(xx*0.4)*4;
      ctx.fillStyle = '#132c0b';
      ctx.fillRect(xx, HORIZON-22-hh, 24, hh+3);
    }
    // soft light haze
    ctx.save(); ctx.globalAlpha = 0.10; ctx.fillStyle = '#fff8d8';
    ctx.beginPath(); ctx.ellipse(W*0.5, 20, 120, 40, 0, 0, Math.PI*2); ctx.fill();
    ctx.restore();
  }

  function drawGroundPlane() {
    const PATH_HALF = 1.15;  // dirt path half-width in world units

    currentCurve += (targetCurve - currentCurve) * 0.045;
    camAngle     -= currentCurve * 0.0012;
    if (walking) scroll += 0.065;

    const img  = ctx.createImageData(W, ROWS);
    const data = img.data;

    for (let sy = 0; sy < ROWS; sy++) {
      const z = depthLUT[sy];
      const curveX  = -currentCurve * z * z * 0.010;
      const wz_base = z + scroll;
      const fog = z > 50 ? 1 : z / 50;

      for (let sx = 0; sx < W; sx++) {
        const wx = (sx - W*0.5) * z / 200 + curveX;
        const wz = wz_base;

        const absWx  = wx < 0 ? -wx : wx;
        const onPath = absWx < PATH_HALF;
        const onEdge = absWx >= PATH_HALF - 0.12 && absWx < PATH_HALF + 0.20;

        // dirt path texture — mottled, not striped like asphalt
        const speckle = (((wx*7)|0) ^ ((wz*3)|0)) & 3;

        // grass either side, slightly alternating for texture
        const grassCk = (((wx*1.3)|0) + ((wz*0.45)|0)) % 2 === 0;

        // Occasional stone on path
        const stoneNoise = (((wx*11.3+wz*6.1)|0) % 97);
        const onStone = onPath && stoneNoise === 3 && z < 40;

        let r,g,b;
        if (onStone) {
          r=150; g=140; b=125;
        } else if (onEdge) {
          // mossy grass edge, darker
          r=42; g=70; b=26;
        } else if (onPath) {
          const base = 106 + speckle*6;
          r = base; g = (base*0.82)|0; b = (base*0.62)|0;
        } else {
          if (grassCk) { r=40; g=94; b=30; }
          else          { r=34; g=82; b=24; }
        }

        r = (r + (170-r)*fog*0.5)|0;
        g = (g + (190-g)*fog*0.5)|0;
        b = (b + (165-b)*fog*0.5)|0;

        const idx = (sy*W+sx)*4;
        data[idx]=r; data[idx+1]=g; data[idx+2]=b; data[idx+3]=255;
      }
    }
    ctx.putImageData(img, 0, HORIZON);
  }

  // ---- Roadside trees (billboards, Mode-7 style placement) ----
  const TREES = [];
  for (let i=0;i<16;i++) {
    TREES.push({
      z: i/16,
      side: i%2===0 ? -1 : 1,
      col: ['#1a4a0a','#224a10','#1e4210','#254d14'][i%4]
    });
  }

  function drawTrees() {
    const sorted = TREES.slice().sort((a,b)=>a.z-b.z);
    sorted.forEach(tree => {
      const depth    = 200 / Math.max((1-tree.z)*80, 0.5);
      const curveOff = -currentCurve * depth * depth * 0.010;
      const screenX  = W/2 + tree.side * (depth*1.7 + 16) + curveOff;
      const screenY  = HORIZON + (H-HORIZON) * tree.z;

      if (screenX < -30 || screenX > W+30 || screenY > H+10) return;

      const sc = 0.12 + tree.z * 0.85;
      const bY = Math.min(screenY + 4, H);

      ctx.save(); ctx.globalAlpha = 0.15 * tree.z;
      ctx.fillStyle = '#000';
      ctx.beginPath(); ctx.ellipse(screenX, bY, 13*sc, 4*sc, 0,0,Math.PI*2); ctx.fill();
      ctx.restore();

      ctx.fillStyle = 'rgb('+((42*sc+15)|0)+','+((30*sc+12)|0)+','+((15*sc+6)|0)+')';
      ctx.fillRect(screenX-2*sc, bY-20*sc, 4*sc, 20*sc);

      ctx.fillStyle = tree.col;
      ctx.beginPath(); ctx.ellipse(screenX, bY-20*sc-13*sc, 14*sc, 17*sc, 0,0,Math.PI*2); ctx.fill();

      if (walking) {
        tree.z += 0.0055;
        if (tree.z > 1.05) {
          tree.z = 0.01;
          tree.side = Math.random() > 0.5 ? 1 : -1;
        }
      }
    });
  }

  // ---- Fallen leaves drifting over the scene ----
  let leaves = [];
  function initLeaves() {
    leaves = Array.from({length:10}, () => ({
      x: Math.random()*W, y: HORIZON + Math.random()*(H-HORIZON),
      vy: .15+Math.random()*.3, vx: -.1+Math.random()*.2,
      sz: 2.5+Math.random()*3.5,
      c: ['#6b4a1e','#8a6030','#7a5528'][Math.floor(Math.random()*3)],
      r: Math.random()*360
    }));
  }
  function drawLeaves() {
    leaves.forEach(l => {
      ctx.save(); ctx.translate(l.x,l.y); ctx.rotate(l.r*Math.PI/180);
      ctx.fillStyle = l.c;
      ctx.beginPath(); ctx.ellipse(0,0,l.sz,l.sz*0.45,0,0,Math.PI*2); ctx.fill();
      ctx.restore();
      l.y += l.vy; l.x += l.vx; l.r += 0.2;
      if (l.y > H+5) { l.y = HORIZON-5; l.x = Math.random()*W; }
    });
  }

  function renderFrame() {
    drawSky();
    drawGroundPlane();
    drawTrees();
    drawLeaves();
  }

  // ============================================================
  // MAIN LOOP
  // ============================================================
  let raf = null, tailT = 0, dogBob = 0;

  function loop() {
    tailT += 0.20;
    renderFrame();

    const bobY = walking ? Math.sin(dogBob) * 3.2 : 0;
    if (walking) dogBob += 0.15;
    const sc = 1 + (G.level - 1) * 0.10;
    elDogs.style.transform = `translateX(-50%) translateY(${bobY}px) scale(${Math.min(sc,1.5)})`;

    elTL.setAttribute('d', `M21 73 Q${8+Math.sin(tailT)*5} ${62+Math.cos(tailT)*3} 12 51`);
    elTR.setAttribute('d', `M129 73 Q${142+Math.sin(tailT)*5} ${62+Math.cos(tailT)*3} 138 51`);

    raf = requestAnimationFrame(loop);
  }

  // ============================================================
  // GAME LOGIC
  // ============================================================
  const G = {
    hp:3, score:0, level:1, wins:0, phase:'idle', enemy:null,

    rnd(a) { return a[Math.floor(Math.random()*a.length)]; },
    setSt(t) { elSt.textContent = t; },
    updHP() { elHp.forEach((el,i) => el.textContent = i < this.hp ? '🐾' : '💔'); },

    flash(msg, good) {
      elFlash.textContent = msg;
      elFlash.style.color = good ? '#90ff90' : '#ff9090';
      elFlash.style.display = 'block';
      setTimeout(() => elFlash.style.display = 'none', 1300);
    },

    showBtns(arr) {
      elBtns.innerHTML = '';
      arr.forEach(b => {
        const d = document.createElement('div');
        d.className = 'gb ' + (b.cls||'');
        d.textContent = b.label;
        d.onclick = b.fn;
        elBtns.appendChild(d);
      });
    },

    start() {
      this.hp=3; this.score=0; this.level=1; this.wins=0;
      elLv.textContent = 1; elScore.textContent = 0;
      this.updHP(); initLeaves();
      walking = false; currentCurve = 0; targetCurve = 0; camAngle = 0;
      if (!raf) loop();
      this.crossPhase();
    },

    crossPhase() {
      this.phase = 'walking';
      walking = false;
      const cross = this.rnd(CROSSINGS);
      elBiome.textContent = cross.icon + ' ' + cross.name;
      elBiome.style.display = 'block';
      this.setSt(cross.name + ' framför er!');
      this.showBtns(cross.dirs.map(d => ({
        label: d.l, cls: 'pt',
        fn: () => {
          elBtns.querySelectorAll('.gb').forEach(b => b.style.pointerEvents = 'none');
          elBiome.style.display = 'none';
          this.setSt('Ni rör er framåt...');
          walking = true;
          setCurve(d.v, true);
          setTimeout(() => {
            walking = false;
            this.spawnEnemy();
          }, 1900);
        }
      })));
    },

    spawnEnemy() {
      const pool = ENEMIES.filter(e => e.lv <= Math.min(this.level, 3));
      this.enemy = this.rnd(pool);
      elEnemy.textContent = this.enemy.icon;
      elEnemy.style.display = 'block';
      elEnemy.classList.remove('near');
      setTimeout(() => elEnemy.classList.add('near'), 80);
      setTimeout(() => {
        this.setSt(`En ${this.enemy.name}! ${this.enemy.hint}`);
        this.fightPhase();
      }, 1000);
    },

    fightPhase() {
      this.phase = 'fighting';
      this.showBtns([
        {label:'🦘 Hoppa', cls:'at', fn:()=>this.attack('hoppa')},
        {label:'🗣 Skälla',cls:'at', fn:()=>this.attack('skälla')},
        {label:'🦷 Bita',  cls:'at', fn:()=>this.attack('bita')},
      ]);
    },

    attack(type) {
      if (this.phase !== 'fighting') return;
      this.phase = 'resolving';
      const win = this.enemy.good.includes(type);
      elEnemy.classList.remove('near');
      setTimeout(() => elEnemy.style.display = 'none', 700);

      if (win) {
        this.wins++;
        const pts = this.level * 10;
        this.score += pts;
        elScore.textContent = this.score;
        this.flash(`Rätt! +${pts}p 🎉`, true);
        if (this.wins % 2 === 0) {
          this.level++;
          elLv.textContent = this.level;
          this.setSt(`Nivå ${this.level}! Hundarna växer!`);
        } else {
          this.setSt('Bra jobbat!');
        }
      } else {
        this.hp = Math.max(0, this.hp-1);
        this.updHP();
        this.flash('Fel attack! 💥', false);
        this.setSt(`${this.enemy.name} vann...`);
      }

      if (this.hp <= 0) setTimeout(() => this.gameOver(), 1400);
      else              setTimeout(() => this.crossPhase(), 1600);
    },

    gameOver() {
      this.phase = 'idle';
      this.setSt(`Game over! Nivå ${this.level} — ${this.score}p`);
      elBiome.style.display = 'none';
      this.showBtns([{label:'🐕 Ny promenad', fn:()=>this.start()}]);
    }
  };

  // ---- Boot ----
  initLeaves();
  renderFrame();
  G.showBtns([{label:'🐕 Börja promenaden', fn:()=>G.start()}]);

}; // end window.onload
</script>
</body>
</html>
